[global]
    monitor = 0
    follow = mouse
    width = 350
    origin = top-right
    offset = (12, 42)
    corner_radius = 8
    frame_width = 2
    frame_color = "#cba6f7"
    font = JetBrainsMono Nerd Font 10
    padding = 10
    horizontal_padding = 12
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
