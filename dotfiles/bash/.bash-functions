    _ok "Staged: $1"
}

# dots_commit — commit staged dotfiles
dots_commit() {
    local msg="${1:-Update dotfiles $(util_iso8601)}"
    local repo="${DOTFILES_REPO:-$HOME/.dotfiles}"
    git --git-dir="$repo" --work-tree="$HOME" commit -m "$msg"
}

# dots_push — push dotfiles to remote
dots_push() {
    local repo="${DOTFILES_REPO:-$HOME/.dotfiles}"
    git --git-dir="$repo" --work-tree="$HOME" push
}

# dots_log — log of dotfile commits
dots_log() {
    local repo="${DOTFILES_REPO:-$HOME/.dotfiles}"
    git --git-dir="$repo" --work-tree="$HOME" log --oneline --graph --decorate
}

# dots_stow_apply — apply a GNU Stow package from dotfiles dir
# Usage: dots_stow_apply <package>  (e.g. nvim, zsh, git)
dots_stow_apply() {
    _require stow
    local dots_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"
    [[ -z "$1" ]] && { _err "Usage: dots_stow_apply <package>"; return 1; }
    stow --target="$HOME" --dir="$dots_dir" --restow "$1"
    _ok "Stowed: $1"
}

# dots_stow_remove — remove symlinks for a stow package
dots_stow_remove() {
    _require stow
    local dots_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"
    [[ -z "$1" ]] && { _err "Usage: dots_stow_remove <package>"; return 1; }
    stow --target="$HOME" --dir="$dots_dir" --delete "$1"
    _ok "Unstowed: $1"
}

# dots_stow_apply_all — apply all packages in dotfiles directory
dots_stow_apply_all() {
    _require stow
    local dots_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"
    _title "Stowing all packages in $dots_dir"
    for pkg in "$dots_dir"/*/; do
        local name
        name=$(basename "$pkg")
        stow --target="$HOME" --dir="$dots_dir" --restow "$name" \
            && _ok "Stowed: $name" \
            || _warn "Skipped: $name (conflict)"
    done
}

# dots_check_broken — find broken symlinks in home directory
dots_check_broken() {
    _title "Broken Symlinks in ~"
    find ~ -maxdepth 5 -xtype l -not -path '*/.git/*' 2>/dev/null | while read -r link; do
        local target
        target=$(readlink "$link")
        echo -e "  ${_clr_red}✘${_clr_reset}  $link  →  $target"
    done
    _ok "Check complete."
}

# dots_backup — snapshot entire home dotfiles set to an archive
dots_backup() {
    local out="${1:-$HOME/dotfiles_backup_$(util_timestamp).tar.gz}"
    _title "Dotfiles Snapshot Backup"
    tar czvf "$out" \
        --exclude='.cache' --exclude='Downloads' --exclude='Videos' \
        --exclude='Music'  --exclude='.local/share/Trash' \
        --exclude='.local/share/containers' \
        -C "$HOME" \
        .bashrc .bash_aliases .bash-aliases .bash-functions \
        .zshrc .zshenv .profile \
        .gitconfig .gitignore_global \
        .config .local/bin .local/share/fonts \
        .ssh/config .gnupg 2>/dev/null
    _ok "Backup: $out  ($(du -sh "$out" | cut -f1))"
}


