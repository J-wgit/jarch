# ctr_docker_clean — remove stopped containers, dangling images, unused volumes
ctr_docker_clean() {
    _require docker
    _title "Docker Cleanup"
    _section "Stopped containers"
    docker container prune -f
    _section "Dangling images"
    docker image prune -f
    _section "Unused volumes"
    docker volume prune -f
    _section "Unused networks"
    docker network prune -f
    _ok "Docker cleaned."
}

# ctr_docker_shell — drop into a running container
# Usage: ctr_docker_shell <container> [shell=bash]
ctr_docker_shell() {
    [[ -z "$1" ]] && { _err "Usage: ctr_docker_shell <container> [shell]"; return 1; }
    local shell="${2:-bash}"
    docker exec -it "$1" "$shell" || docker exec -it "$1" sh
}

# ctr_docker_logs_all — stream logs from all running containers
ctr_docker_logs_all() {
    _require docker
    for container in $(docker ps --format '{{.Names}}'); do
        _info "=== $container ==="
        docker logs --tail=20 "$container"
    done
}

# ctr_docker_ip — show IP addresses of all running containers
ctr_docker_ip() {
    _require docker
    docker inspect --format '{{.Name}} {{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
        $(docker ps -q) | column -t
}

# ctr_docker_stats — live resource stats for all containers
ctr_docker_stats() {
    docker stats
}

# ctr_compose_up — bring up a compose project (build if needed)
ctr_compose_up() {
