# bak_file — create a timestamped backup copy of a file
bak_file() {
    [[ -z "$1" ]] && { _err "Usage: bak_file <file>"; return 1; }
    local src="$1"
    [[ -e "$src" ]] || { _err "Not found: $src"; return 1; }
    local dst="${src}.bak.$(util_timestamp)"
    cp -a "$src" "$dst" && _ok "Backup: $dst"
}

# bak_dir — create a compressed backup of a directory
# Usage: bak_dir <dir> [dest_dir=$HOME/backups]
bak_dir() {
    [[ -z "$1" ]] && { _err "Usage: bak_dir <dir> [dest]"; return 1; }
    local src="${1%/}"
    local dest="${2:-$HOME/backups}"
    mkdir -p "$dest"
    local name
    name="$(basename "$src")_$(util_timestamp).tar.gz"
    tar czvf "$dest/$name" "$src"
    _ok "Backup: $dest/$name"
    ls -lh "$dest/$name"
}

# bak_home_config — backup all XDG config and dotfiles
bak_home_config() {
    local dest="${1:-$HOME/backups}"
    local name="home_config_$(util_timestamp).tar.gz"
    mkdir -p "$dest"
    _info "Backing up ~/.config, ~/.local/share, and dotfiles..."
    tar czvf "$dest/$name" \
        --exclude='~/.cache' \
        --exclude='~/.local/share/Trash' \
        --exclude='~/.local/share/containers' \
        ~/.config \
        ~/.local/share \
        ~/.bashrc ~/.zshrc ~/.profile \
        ~/.gitconfig ~/.ssh/config \
        2>/dev/null
    _ok "Config backup: $dest/$name"
    ls -lh "$dest/$name"
}

# bak_pkg_list — save explicit package list for later restoration
bak_pkg_list() {
    local dest="${1:-$HOME/backups/pkglist_$(util_timestamp).txt}"
    mkdir -p "$(dirname "$dest")"
    pacman -Qe > "$dest"
    _ok "Package list saved: $dest"
    _info "Restore with: sudo pacman -S - < $dest"
}

# bak_pkg_list_restore — restore packages from a saved list
bak_pkg_list_restore() {
    [[ -z "$1" ]] && { _err "Usage: bak_pkg_list_restore <pkglist.txt>"; return 1; }
    [[ -f "$1" ]] || { _err "File not found: $1"; return 1; }
    _confirm "Install all packages from $1?" || return 1
    sudo pacman -S --needed - < "$1"
}

# bak_rsync — rsync backup to a remote or local destination
# Usage: bak_rsync <source> <dest>  (dest can be user@host:/path)
bak_rsync() {
    [[ $# -lt 2 ]] && { _err "Usage: bak_rsync <source> <dest>"; return 1; }
    _require rsync
    rsync -avzh --progress --delete --exclude='.cache/' \
        --exclude='node_modules/' --exclude='__pycache__/' \
        --exclude='target/' --exclude='.git/' \
        "$1" "$2"
}

# bak_rsync_dry — dry-run rsync to preview what would change
bak_rsync_dry() {
    [[ $# -lt 2 ]] && { _err "Usage: bak_rsync_dry <source> <dest>"; return 1; }
    _require rsync
    rsync -avzh --dry-run --delete "$1" "$2"
}


