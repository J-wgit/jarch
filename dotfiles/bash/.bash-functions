# =============================================================================
# 5. FILESYSTEM & DISK (fs_*)
# =============================================================================

# fs_usage — visual disk usage for a path (uses ncdu if available)
fs_usage() {
    local path="${1:-.}"
    if command -v ncdu &>/dev/null; then
        ncdu "$path"
    else
        du -sh "${path%/}"/* 2>/dev/null | sort -h
    fi
}

# fs_largest — find the N largest files under a path
# Usage: fs_largest [n=20] [path=.]
fs_largest() {
    local n="${1:-20}" path="${2:-.}"
    _title "Top $n largest files in $path"
    find "$path" -xdev -type f -printf '%s\t%p\n' 2>/dev/null \
        | sort -rn | head -"$n" \
        | awk '{
            size=$1; file=$2; unit="B"
            if(size>1073741824){size/=1073741824; unit="GiB"}
            else if(size>1048576){size/=1048576; unit="MiB"}
            else if(size>1024){size/=1024; unit="KiB"}
            printf "%7.1f %-4s  %s\n", size, unit, file
        }'
}

# fs_empty — find and optionally remove empty files/dirs
# Usage: fs_empty [path=.] [--remove]
fs_empty() {
    local path="${1:-.}" remove=false
    [[ "${2:-}" == "--remove" ]] && remove=true

    _title "Empty files and directories in $path"
    _section "Empty files"
    find "$path" -type f -empty -not -path '*/.git/*'

    _section "Empty directories"
    find "$path" -type d -empty -not -path '*/.git/*'

    if $remove; then
        _confirm "Remove all found empty files and dirs?" || return 1
        find "$path" -type f -empty -not -path '*/.git/*' -delete
        find "$path" -type d -empty -not -path '*/.git/*' -delete
        _ok "Removed."
    fi
}

# fs_dupes — find duplicate files by MD5 hash
# Usage: fs_dupes [path=.]
fs_dupes() {
    local path="${1:-.}"
    _title "Finding duplicate files in: $path"
    find "$path" -type f -not -path '*/.git/*' -exec md5sum {} + 2>/dev/null \
        | sort | awk '{
            if ($1 == prev_hash) {
                if (!printed) { print prev_file; printed=1 }
                print $2
            } else {
                prev_hash=$1; prev_file=$2; printed=0
            }
        }'
}

# fs_old — find files not accessed/modified in N days
# Usage: fs_old [days=30] [path=.]
fs_old() {
    local days="${1:-30}" path="${2:-.}"
    _title "Files not modified in $days days: $path"
    find "$path" -type f -mtime +"$days" -not -path '*/.git/*' | sort
}

# fs_recent — find files modified in the last N minutes
# Usage: fs_recent [minutes=60] [path=.]
fs_recent() {
    local mins="${1:-60}" path="${2:-.}"
    _title "Files modified in last $mins minutes: $path"
    find "$path" -type f -mmin -"$mins" -not -path '*/.git/*' | sort
}

# fs_watch — watch a directory for changes (requires inotifywait)
# Usage: fs_watch [path=.]
fs_watch() {
    _require inotifywait
    local path="${1:-.}"
    _info "Watching: $path  (Ctrl+C to stop)"
    inotifywait -m -r -e modify,create,delete,move "$path"
}

# fs_mount_list — show all mounted filesystems in a readable table
fs_mount_list() {
    findmnt -D
}

# fs_mount_iso — mount an ISO image to a temp dir
# Usage: fs_mount_iso <file.iso>
fs_mount_iso() {
    [[ -z "$1" ]] && { _err "Usage: fs_mount_iso <file.iso>"; return 1; }
    local iso="$1"
    local mnt
    mnt=$(mktemp -d /tmp/iso-XXXX)
    sudo mount -o loop,ro "$iso" "$mnt"
    _ok "Mounted $iso → $mnt"
    echo "$mnt"
}

# fs_disk_smart — full SMART report for a disk
# Usage: fs_disk_smart <device>
fs_disk_smart() {
    _require smartctl
    [[ -z "$1" ]] && { _err "Usage: fs_disk_smart <device>   e.g. /dev/sda"; return 1; }
    sudo smartctl -a "$1"
}

# fs_inodes — show inode usage per filesystem
fs_inodes() {
    _title "Inode Usage"
    df -i | sort -k5 -rh
}

# fs_permissions_audit — find world-writable or SUID files in a path
# Usage: fs_permissions_audit [path=/]
fs_permissions_audit() {
    local path="${1:-/}"
    _title "Permission Audit: $path"
    _section "World-writable files"
    sudo find "$path" -xdev -type f -perm -0002 -not -path '/proc/*' 2>/dev/null
    _section "SUID files"
    sudo find "$path" -xdev -type f -perm -4000 2>/dev/null
    _section "SGID files"
    sudo find "$path" -xdev -type f -perm -2000 2>/dev/null
}


# =============================================================================
# 6. PROCESS & RESOURCE MANAGEMENT (proc_*)
# =============================================================================

# proc_top_cpu — show top N processes by CPU
proc_top_cpu() {
    local n="${1:-15}"
    _title "Top $n Processes by CPU"
    ps aux --sort=-%cpu | head -$(( n + 1 ))
}

# proc_top_mem — show top N processes by memory
proc_top_mem() {
    local n="${1:-15}"
    _title "Top $n Processes by Memory"
    ps aux --sort=-%mem | head -$(( n + 1 ))
}

# proc_find — search for processes by name
proc_find() {
    [[ -z "$1" ]] && { _err "Usage: proc_find <name>"; return 1; }
    ps aux | grep -v grep | grep --color=auto -i "$1"
}

# proc_tree — process tree for a given PID or name
proc_tree() {
    local target="${1:-1}"
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        pstree -p "$target"
    else
        pstree -p "$(pgrep "$target" | head -1)"
    fi
}

# proc_limits — show resource limits for a running process
proc_limits() {
    [[ -z "$1" ]] && { _err "Usage: proc_limits <pid>"; return 1; }
    cat "/proc/$1/limits"
}

# proc_open_files — list open files for a PID (or all processes)
proc_open_files() {
    local pid="${1:-}"
    if [[ -n "$pid" ]]; then
        sudo lsof -p "$pid"
    else
        sudo lsof | less
    fi
}

# proc_open_ports — show which processes have open network connections
proc_open_ports() {
    sudo ss -tulnp
}

# proc_kill_name — kill all processes matching a name
proc_kill_name() {
    [[ -z "$1" ]] && { _err "Usage: proc_kill_name <name>"; return 1; }
    _warn "Killing all processes matching: $1"
    _confirm "Proceed?" || return 1
    pkill -SIGTERM -f "$1"
    sleep 2
    pkill -SIGKILL -f "$1" 2>/dev/null
    _ok "Done."
}

# proc_nice_set — renice a running process
# Usage: proc_nice_set <pid> <nice_value>  (-20 high priority, 19 low)
proc_nice_set() {
    [[ $# -lt 2 ]] && { _err "Usage: proc_nice_set <pid> <nice>"; return 1; }
    sudo renice -n "$2" -p "$1"
}

# proc_watch — live process stats for a specific process
proc_watch() {
    [[ -z "$1" ]] && { _err "Usage: proc_watch <name|pid>"; return 1; }
    watch -n 1 "ps aux | grep -v grep | grep '$1'"
}

# proc_strace_cmd — strace a command and save output
# Usage: proc_strace_cmd <command> [args...]
proc_strace_cmd() {
    _require strace
    [[ -z "$1" ]] && { _err "Usage: proc_strace_cmd <command> [args]"; return 1; }
    local out="/tmp/strace_$(util_timestamp).log"
    strace -f -tt -o "$out" "$@"
    _ok "strace output saved to: $out"
}

# proc_iowait — show I/O wait per process
proc_iowait() {
    _require iotop
    sudo iotop -a -o
}


# =============================================================================
# 7. NETWORKING & CONNECTIVITY (net_*)
# =============================================================================

# net_info — full network interface summary
net_info() {
    _title "Network Information"
    _section "Interfaces"
    ip -c a
    _section "Routing Table"
    ip -c r
    _section "DNS"
    resolvectl status 2>/dev/null || cat /etc/resolv.conf
}

# net_check — test connectivity at multiple layers
# Usage: net_check [host=1.1.1.1]
net_check() {
    local host="${1:-1.1.1.1}"
    _title "Connectivity Check"
    _section "Ping: $host"
    ping -c 3 "$host" && _ok "Network reachable." || _err "Ping failed."
    _section "DNS Resolution"
    nslookup archlinux.org && _ok "DNS working." || _err "DNS failed."
    _section "HTTPS"
    curl -s --max-time 5 https://archlinux.org > /dev/null && _ok "HTTPS working." || _err "HTTPS failed."
}

# net_speed — quick download speed test
net_speed() {
    _info "Testing download speed..."
    if command -v speedtest-cli &>/dev/null; then
        speedtest-cli
    else
        curl -o /dev/null -s -w "  Downloaded: %{size_download} bytes\n  Speed: %{speed_download} bytes/s\n  Time: %{time_total}s\n" \
            https://speed.cloudflare.com/__down?bytes=10000000
    fi
}

# net_ports_open — scan localhost for listening ports
net_ports_open() {
    _title "Listening Ports"
    sudo ss -tulnp | sort -k5
}

# net_port_check — check if a remote port is open
# Usage: net_port_check <host> <port>
net_port_check() {
    [[ $# -lt 2 ]] && { _err "Usage: net_port_check <host> <port>"; return 1; }
    if timeout 3 bash -c "echo >/dev/tcp/$1/$2" 2>/dev/null; then
        _ok "Port $2 is OPEN on $1"
    else
        _err "Port $2 is CLOSED on $1"
    fi
}

# net_myip — show public IP addresses (IPv4 and IPv6)
net_myip() {
    _info "IPv4 : $(curl -s -4 ifconfig.me)"
    _info "IPv6 : $(curl -s -6 ifconfig.me 2>/dev/null || echo 'N/A')"
}

# net_dns_lookup — comprehensive DNS lookup for a domain
# Usage: net_dns_lookup <domain>
net_dns_lookup() {
    [[ -z "$1" ]] && { _err "Usage: net_dns_lookup <domain>"; return 1; }
    _title "DNS Records: $1"
    for type in A AAAA MX NS TXT CNAME SOA; do
        _section "$type"
        dig +short "$type" "$1" 2>/dev/null || echo "  (none)"
    done
}

# net_trace — traceroute to a host with DNS
net_trace() {
    [[ -z "$1" ]] && { _err "Usage: net_trace <host>"; return 1; }
    if command -v mtr &>/dev/null; then
        mtr --report --report-cycles 5 "$1"
    else
        traceroute "$1"
    fi
}

# net_serve — start a quick HTTP server in current directory
# Usage: net_serve [port=8000]
net_serve() {
    local port="${1:-8000}"
    _info "Serving $(pwd) on http://0.0.0.0:$port"
    python3 -m http.server "$port"
}

# net_capture — capture network traffic on an interface
# Usage: net_capture [interface=any] [filter]
net_capture() {
    _require tcpdump
    local iface="${1:-any}" filter="${2:-}"
    local out="/tmp/capture_$(util_timestamp).pcap"
    _info "Capturing on $iface → $out  (Ctrl+C to stop)"
    # shellcheck disable=SC2086
    sudo tcpdump -i "$iface" -w "$out" $filter
    _ok "Saved to: $out"
}

# net_wifi_scan — scan for available WiFi networks
net_wifi_scan() {
    _require nmcli
    nmcli device wifi list
}

# net_wifi_connect — connect to a WiFi network
# Usage: net_wifi_connect <SSID> [password]
net_wifi_connect() {
    _require nmcli
    [[ -z "$1" ]] && { _err "Usage: net_wifi_connect <SSID> [password]"; return 1; }
    if [[ -n "$2" ]]; then
        nmcli device wifi connect "$1" password "$2"
    else
        nmcli device wifi connect "$1"
    fi
}

# net_hosts_add — add an entry to /etc/hosts
# Usage: net_hosts_add <ip> <hostname>
net_hosts_add() {
    [[ $# -lt 2 ]] && { _err "Usage: net_hosts_add <ip> <hostname>"; return 1; }
    echo "$1 $2" | sudo tee -a /etc/hosts
    _ok "Added: $1  $2"
}

# net_firewall_status — show nftables or iptables rules
net_firewall_status() {
    _title "Firewall Status"
    if command -v nft &>/dev/null; then
        sudo nft list ruleset
    elif command -v iptables &>/dev/null; then
        sudo iptables -L -n -v
    else
        _warn "No firewall utility found."
    fi
}


# =============================================================================
# 8. USER & PERMISSION MANAGEMENT (usr_*)
# =============================================================================

# usr_info — show current user and group memberships
usr_info() {
    _title "User Information"
    echo "  User    : $USER (UID: $UID)"
    echo "  Home    : $HOME"
    echo "  Shell   : $SHELL"
    echo "  Groups  : $(groups)"
    id
}

# usr_add — create a new system user with home directory
# Usage: usr_add <username> [groups]
usr_add() {
    [[ -z "$1" ]] && { _err "Usage: usr_add <username> [group,group]"; return 1; }
    local user="$1" groups="${2:-}"
    sudo useradd -m -s /bin/bash "$user"
    [[ -n "$groups" ]] && sudo usermod -aG "$groups" "$user"
    sudo passwd "$user"
    _ok "User created: $user"
}

# usr_groups_add — add current or named user to groups
# Usage: usr_groups_add <group[,group...]> [user=$USER]
usr_groups_add() {
    [[ -z "$1" ]] && { _err "Usage: usr_groups_add <groups> [user]"; return 1; }
    local groups="$1" user="${2:-$USER}"
    sudo usermod -aG "$groups" "$user"
    _ok "Added $user to groups: $groups"
    _info "Re-login or run: newgrp <group>"
}

# usr_sudoers_check — validate /etc/sudoers syntax
usr_sudoers_check() {
    sudo visudo -c && _ok "sudoers syntax OK."
}

# usr_login_history — show login history
usr_login_history() {
    last -n "${1:-20}"
}

# usr_failed_logins — show failed login attempts
usr_failed_logins() {
    sudo faillock --user "${1:-}"
    sudo journalctl -g "Failed password\|authentication failure" --since="7 days ago" --no-pager | tail -30
}

# usr_lock — lock a user account
usr_lock() {
    [[ -z "$1" ]] && { _err "Usage: usr_lock <username>"; return 1; }
    sudo passwd -l "$1" && _ok "Locked: $1"
}

# usr_unlock — unlock a user account
usr_unlock() {
    [[ -z "$1" ]] && { _err "Usage: usr_unlock <username>"; return 1; }
    sudo passwd -u "$1" && _ok "Unlocked: $1"
}


# =============================================================================
# 9. SYSTEMD & SERVICES (svc_*)
# =============================================================================

# svc_status — status of a system or user service
# Usage: svc_status <service> [--user]
svc_status() {
    [[ -z "$1" ]] && { _err "Usage: svc_status <service> [--user]"; return 1; }
    local svc="${1%.service}.service" user_flag=""
    [[ "${2:-}" == "--user" ]] && user_flag="--user"
    systemctl $user_flag status "$svc"
}

# svc_enable — enable and start a service
# Usage: svc_enable <service> [--user]
svc_enable() {
    [[ -z "$1" ]] && { _err "Usage: svc_enable <service> [--user]"; return 1; }
    local svc="${1%.service}" user_flag=""
    [[ "${2:-}" == "--user" ]] && user_flag="--user"
    sudo systemctl $user_flag enable --now "$svc"
    _ok "Enabled and started: $svc"
}

# svc_disable — disable and stop a service
svc_disable() {
    [[ -z "$1" ]] && { _err "Usage: svc_disable <service> [--user]"; return 1; }
    local svc="${1%.service}" user_flag=""
    [[ "${2:-}" == "--user" ]] && user_flag="--user"
    sudo systemctl $user_flag disable --now "$svc"
    _ok "Disabled and stopped: $svc"
}

# svc_restart — restart a service
svc_restart() {
    [[ -z "$1" ]] && { _err "Usage: svc_restart <service> [--user]"; return 1; }
    local svc="${1%.service}" user_flag=""
    [[ "${2:-}" == "--user" ]] && user_flag="--user"
    sudo systemctl $user_flag restart "$svc" && _ok "Restarted: $svc"
}

# svc_reload_daemon — reload systemd manager configuration
svc_reload_daemon() {
    sudo systemctl daemon-reload && _ok "Systemd daemon reloaded."
    systemctl --user daemon-reload && _ok "User daemon reloaded."
}

# svc_logs — follow logs for a service
# Usage: svc_logs <service> [--user] [--lines=50]
svc_logs() {
    [[ -z "$1" ]] && { _err "Usage: svc_logs <service> [--user]"; return 1; }
    local svc="$1" user_flag="" lines=50
    [[ "${2:-}" == "--user" ]] && user_flag="--user"
    journalctl $user_flag -f -n "$lines" -u "$svc"
}

# svc_create_user — create a systemd user service from a template
# Usage: svc_create_user <name> <exec_command> [description]
svc_create_user() {
    [[ $# -lt 2 ]] && { _err "Usage: svc_create_user <name> <exec> [desc]"; return 1; }
    local name="$1" exec="$2" desc="${3:-$1 service}"
    local unit_dir="$HOME/.config/systemd/user"
    local unit_file="$unit_dir/${name}.service"
    mkdir -p "$unit_dir"
    cat > "$unit_file" <<EOF
[Unit]
Description=$desc
After=default.target

[Service]
Type=simple
ExecStart=$exec
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
    _ok "Created: $unit_file"
    systemctl --user daemon-reload
    _info "Enable with: svc_enable $name --user"
}

# svc_list_running — list all currently running services
svc_list_running() {
    _title "Running Services"
    _section "System"
    systemctl list-units --type=service --state=running
    _section "User"
    systemctl --user list-units --type=service --state=running
}

# svc_list_failed — list all failed services
svc_list_failed() {
    _title "Failed Services"
    _section "System"
    systemctl --failed
    _section "User"
    systemctl --user --failed
}

# svc_timer_list — list all systemd timers
svc_timer_list() {
    _title "Systemd Timers"
    systemctl list-timers --all
}


# =============================================================================
# 10. SECURITY & CRYPTOGRAPHY (sec_*)
# =============================================================================

# sec_ssh_keygen — generate an Ed25519 SSH key pair
# Usage: sec_ssh_keygen [comment] [filename]
sec_ssh_keygen() {
    local comment="${1:-$(whoami)@$(hostname)}"
    local fname="${2:-$HOME/.ssh/id_ed25519}"
    ssh-keygen -t ed25519 -C "$comment" -f "$fname"
    _ok "Key pair created: $fname"
    _info "Public key:"
    cat "${fname}.pub"
}

# sec_ssh_copy_id — copy SSH public key to a remote host
# Usage: sec_ssh_copy_id <user@host> [keyfile]
sec_ssh_copy_id() {
    [[ -z "$1" ]] && { _err "Usage: sec_ssh_copy_id <user@host> [keyfile]"; return 1; }
    local key="${2:-$HOME/.ssh/id_ed25519.pub}"
    ssh-copy-id -i "$key" "$1" && _ok "Key copied to $1"
}

# sec_ssh_audit — audit SSH config for security issues
sec_ssh_audit() {
    _title "SSH Configuration Audit"
    _section "Key Permissions"
    find ~/.ssh -name '*.pub' -exec ls -la {} \;
    find ~/.ssh -not -name '*.pub' -not -name 'known_hosts' -not -name 'config' \
        -exec ls -la {} \;

    _section "sshd_config security check (system)"
    if [[ -f /etc/ssh/sshd_config ]]; then
        grep -E 'PermitRootLogin|PasswordAuthentication|X11Forwarding|Protocol|PubkeyAuthentication|AuthorizedKeysFile' \
            /etc/ssh/sshd_config | grep -v '^#'
    fi
}

# sec_gpg_list — list GPG keys
sec_gpg_list() {
    _title "GPG Keys"
    _section "Public Keys"
    gpg --list-keys
    _section "Secret Keys"
    gpg --list-secret-keys
}

# sec_gpg_export — export a GPG public key
# Usage: sec_gpg_export <key_id> [output_file]
sec_gpg_export() {
    [[ -z "$1" ]] && { _err "Usage: sec_gpg_export <key_id> [file]"; return 1; }
    local file="${2:-${1}_public.gpg.asc}"
    gpg --armor --export "$1" > "$file"
    _ok "Exported to: $file"
}

# sec_gpg_sign_file — sign a file with GPG
sec_gpg_sign_file() {
    [[ -z "$1" ]] && { _err "Usage: sec_gpg_sign_file <file>"; return 1; }
    gpg --armor --detach-sign "$1"
    _ok "Signature: ${1}.asc"
}

# sec_gpg_verify — verify a GPG signature
sec_gpg_verify() {
    [[ $# -lt 2 ]] && { _err "Usage: sec_gpg_verify <file> <file.asc>"; return 1; }
    gpg --verify "$2" "$1"
}

# sec_checksum — generate and verify checksums
# Usage: sec_checksum <file> [algo=sha256]
sec_checksum() {
    [[ -z "$1" ]] && { _err "Usage: sec_checksum <file> [sha256|md5|sha512]"; return 1; }
    local algo="${2:-sha256}"
    "${algo}sum" "$1"
}

# sec_checksum_verify — verify a file against a checksum string
# Usage: sec_checksum_verify <file> <expected_hash> [algo=sha256]
sec_checksum_verify() {
    [[ $# -lt 2 ]] && { _err "Usage: sec_checksum_verify <file> <hash> [algo]"; return 1; }
    local file="$1" expected="$2" algo="${3:-sha256}"
    local actual
    actual=$("${algo}sum" "$file" | awk '{print $1}')
    if [[ "$actual" == "$expected" ]]; then
        _ok "Checksum matches: $algo"
    else
        _err "Checksum MISMATCH!"
        _err "  Expected : $expected"
        _err "  Actual   : $actual"
        return 1
    fi
}

# sec_audit_suid — audit SUID/SGID binaries on the system
sec_audit_suid() {
    _title "SUID / SGID Binaries"
    sudo find / -xdev \( -perm -4000 -o -perm -2000 \) -type f 2>/dev/null | sort
}

# sec_pass_show — show passwords from pass store with tree
sec_pass_show() {
    _require pass
    pass ls
}

# sec_env_secrets — check for potential secrets in environment variables
sec_env_secrets() {
    _title "Checking environment variables for potential secrets"
    env | grep -iE 'key|secret|token|password|passwd|api|auth|credential|private' \
        | sed 's/=.*/=<REDACTED>/'
}


