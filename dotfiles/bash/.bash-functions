# git_status_all — git status for all repos in a directory tree
# Usage: git_status_all [base_dir=~/Projects]
git_status_all() {
    local base="${1:-$HOME/Projects}"
    _title "Git Status: all repos under $base"
    while IFS= read -r repo; do
        local dir
        dir=$(dirname "$repo")
        local status
        status=$(git -C "$dir" status --porcelain 2>/dev/null)
        local branch
        branch=$(git -C "$dir" branch --show-current 2>/dev/null)
        if [[ -n "$status" ]]; then
            printf "  ${_clr_yellow}%-50s${_clr_reset} [%s] — dirty\n" "$dir" "$branch"
        else
            printf "  ${_clr_green}%-50s${_clr_reset} [%s] — clean\n" "$dir" "$branch"
        fi
    done < <(find "$base" -name '.git' -maxdepth 5 -type d | sort)
}

# git_pull_all — git pull for all repos under a directory
git_pull_all() {
    local base="${1:-$HOME/Projects}"
    _title "Pulling all repos under $base"
    while IFS= read -r gitdir; do
        local dir
        dir=$(dirname "$gitdir")
        _info "Pulling: $dir"
        git -C "$dir" pull --rebase --autostash 2>&1 | tail -3
    done < <(find "$base" -name '.git' -maxdepth 5 -type d | sort)
}

# git_clean_branches — delete all local branches already merged into main/master
git_clean_branches() {
    local main
    main=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    main="${main:-main}"
    _title "Removing merged branches (base: $main)"
    git branch --merged "$main" | grep -v "^\*\|$main\|master\|dev" | xargs -r git branch -d
    _ok "Merged branches removed."
}

# git_undo_commit — undo the last commit, preserving changes in working tree
git_undo_commit() {
    git reset --soft HEAD~1 && _ok "Last commit undone. Changes are staged."
}

# git_undo_push — revert the last pushed commit (creates a revert commit)
git_undo_push() {
    _confirm "This will create a revert commit and push. Continue?" || return 1
    git revert HEAD --no-edit
    git push
}

# git_log_file — show full history of a specific file
git_log_file() {
    [[ -z "$1" ]] && { _err "Usage: git_log_file <file>"; return 1; }
    git log --follow --all --oneline -p -- "$1"
}

# git_find_string — search entire git history for a string
git_find_string() {
    [[ -z "$1" ]] && { _err "Usage: git_find_string <string>"; return 1; }
    git log --all --oneline --grep="$1"
    git log --all --oneline -S "$1"
}

# git_stats — contributor statistics
git_stats() {
    _title "Repository Statistics"
    _section "Commit count per author"
    git shortlog -sn --all

    _section "Files changed most often"
    git log --all --name-only --format="" | grep -v '^$' | sort | uniq -c | sort -rn | head -20

    _section "Lines of code by author"
    git log --all --no-merges --author='.*' --format='%aN' | sort -u | while read -r author; do
        printf "  %-30s  %d lines\n" "$author" \
            "$(git log --all --no-merges --author="$author" --pretty=tformat: --numstat \
               | awk '{add+=$1; del+=$2} END {print add-del}')"
    done
}

# git_ignore_add — add pattern(s) to .gitignore
git_ignore_add() {
    [[ -z "$1" ]] && { _err "Usage: git_ignore_add <pattern> [...]"; return 1; }
    local gitignore
    gitignore="$(git rev-parse --show-toplevel 2>/dev/null)/.gitignore"
    for pattern in "$@"; do
        echo "$pattern" >> "$gitignore"
        _ok "Added to .gitignore: $pattern"
    done
}

# git_branch_diff — show diff between current branch and another
git_branch_diff() {
    local base="${1:-main}"
    git diff "$base"...HEAD
}

# git_tag_release — create a signed annotated tag
# Usage: git_tag_release <version> [message]
git_tag_release() {
    [[ -z "$1" ]] && { _err "Usage: git_tag_release <v1.0.0> [message]"; return 1; }
    local tag="$1" msg="${2:-Release $1}"
    git tag -s "$tag" -m "$msg"
    _ok "Tag created: $tag"
    _info "Push with: git push origin $tag"
}

# git_worktree_add — add a git worktree for a branch
git_worktree_add() {
    [[ -z "$1" ]] && { _err "Usage: git_worktree_add <branch> [path]"; return 1; }
    local branch="$1"
    local path="${2:-../${branch//\//-}}"
    git worktree add "$path" "$branch"
    _ok "Worktree added: $path"
}

# git_submodule_sync — update all submodules to latest
git_submodule_sync() {
    git submodule update --init --recursive --remote
    _ok "Submodules updated."
}


