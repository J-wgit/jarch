# dev_info — show installed dev tool versions
dev_info() {
    _title "Development Environment"
    local tools=(git gcc g++ clang make cmake python3 node npm rustc cargo go java docker)
    for tool in "${tools[@]}"; do
        if command -v "$tool" &>/dev/null; then
            local ver
            ver=$("$tool" --version 2>&1 | head -1)
            printf "  ${_clr_green}%-12s${_clr_reset} %s\n" "$tool" "$ver"
        else
            printf "  ${_clr_red}%-12s${_clr_reset} not found\n" "$tool"
        fi
    done
}

# dev_init — scaffold a new project directory
# Usage: dev_init <project-name> [type: rust|python|node|c|cpp|generic]
dev_init() {
    [[ -z "$1" ]] && { _err "Usage: dev_init <name> [rust|python|node|c|cpp|generic]"; return 1; }
    local name="$1" type="${2:-generic}"
    [[ -d "$name" ]] && { _err "Directory already exists: $name"; return 1; }

    mkdir -p "$name" && cd "$name" || return 1
    git init

    case "$type" in
        rust)
            cargo init --name "$name" .
            ;;
        python)
            mkdir -p src tests docs
            touch "src/__init__.py" "tests/__init__.py"
            python3 -m venv .venv
            cat > pyproject.toml <<EOF
[project]
name = "$name"
version = "0.1.0"
requires-python = ">=3.11"
EOF
            cat > .gitignore <<'EOF'
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
EOF
            ;;
        node)
            mkdir -p src tests
            npm init -y
            cat > .gitignore <<'EOF'
node_modules/
dist/
.env
*.log
EOF
            ;;
        c|cpp)
            mkdir -p src include tests build
            cat > Makefile <<EOF
CC = gcc
CFLAGS = -Wall -Wextra -Wpedantic -O2 -g
SRC = \$(wildcard src/*.c)
OBJ = \$(SRC:src/%.c=build/%.o)
BIN = build/$name

all: \$(BIN)

\$(BIN): \$(OBJ)
	\$(CC) \$(CFLAGS) -o \$@ \$^

build/%.o: src/%.c | build
	\$(CC) \$(CFLAGS) -I include -c -o \$@ \$<

build:
	mkdir -p build

clean:
	rm -rf build

.PHONY: all clean
EOF
            echo '#include <stdio.h>

int main(void) {
    printf("Hello, World!\n");
    return 0;
}' > "src/main.c"
            ;;
        generic|*)
            mkdir -p src docs tests
            ;;
    esac

    # Common files
    cat > README.md <<EOF
# $name

## Overview

## Getting Started

## Development

## License
EOF

    cat > .editorconfig <<'EOF'
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab
EOF

    git add .
    git commit -m "chore: initial project scaffold ($type)"
    _ok "Project '$name' ($type) created and committed."
}

