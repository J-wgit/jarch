# ai_context_size — show context window usage for a directory of files
# Usage: ai_context_size [path=.] [--ext=.py,.rs,.ts]
ai_context_size() {
    local path="${1:-.}"
    local total_chars=0 total_files=0
    while IFS= read -r f; do
        local size
        size=$(wc -c < "$f" 2>/dev/null || echo 0)
        (( total_chars += size ))
        (( total_files++ ))
    done < <(find "$path" -type f \
        \( -name "*.py" -o -name "*.rs" -o -name "*.ts" -o -name "*.js" \
           -o -name "*.go" -o -name "*.c" -o -name "*.cpp" -o -name "*.h" \
           -o -name "*.lua" -o -name "*.sh" -o -name "*.md" \) \
        -not -path '*/.git/*' -not -path '*/node_modules/*' \
        -not -path '*/.venv/*' -not -path '*/target/*')

    local est_tokens=$(( total_chars / 4 ))
    _title "AI Context Size Estimate: $path"
    printf "  Files     : %d\n" "$total_files"
    printf "  Characters: %d\n" "$total_chars"
    printf "  Est. tokens: ~%d\n" "$est_tokens"
    echo ""
    _section "Context window comparison"
    printf "  GPT-4       128k  — %s\n" "$(python3 -c "t=$est_tokens; print(f'{t/128000*100:.1f}%% used ({128000-t:,} remaining)')" 2>/dev/null)"
    printf "  Claude 3.5  200k  — %s\n" "$(python3 -c "t=$est_tokens; print(f'{t/200000*100:.1f}%% used ({200000-t:,} remaining)')" 2>/dev/null)"
    printf "  Gemini 1.5 1000k  — %s\n" "$(python3 -c "t=$est_tokens; print(f'{t/1000000*100:.1f}%% used ({1000000-t:,} remaining)')" 2>/dev/null)"
}

