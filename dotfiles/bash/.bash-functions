# log_tail — tail logs with optional filter
# Usage: log_tail [unit] [--user]
log_tail() {
    local user_flag=""
    [[ "${2:-}" == "--user" ]] && user_flag="--user"
    if [[ -n "$1" ]]; then
        journalctl $user_flag -f -n 100 -u "$1"
    else
        journalctl $user_flag -f -n 100
    fi
}

# log_errors — show recent errors from journal
# Usage: log_errors [hours=1]
log_errors() {
    local hours="${1:-1}"
    _title "Errors in the last ${hours}h"
    journalctl -p err -xb --since="${hours} hours ago" --no-pager
}

# log_boot — full log for current boot
log_boot() {
    journalctl -b "${1:-0}" | less
}

# log_kernel — kernel ring buffer
log_kernel() {
    sudo dmesg --color=always | less
}

# log_kernel_watch — live kernel messages
log_kernel_watch() {
    sudo dmesg -w --color=always
}

# log_auth — authentication log
log_auth() {
    journalctl -u systemd-logind -u polkit -g 'auth\|login\|sudo\|pam' \
        --since="${1:-24 hours ago}" --no-pager | less
}

# log_search — full-text search across journal
# Usage: log_search <pattern> [--since="1 hour ago"]
log_search() {
    [[ -z "$1" ]] && { _err "Usage: log_search <pattern> [--since=...]"; return 1; }
    local pattern="$1"; shift
    journalctl -g "$pattern" "$@" --no-pager
}

# log_size — show journal disk usage
log_size() {
    journalctl --disk-usage
}

# log_monitor_cpu — log CPU stats to a file every N seconds
# Usage: log_monitor_cpu [interval=5] [output=/tmp/cpu_log.txt]
log_monitor_cpu() {
    local interval="${1:-5}" out="${2:-/tmp/cpu_log_$(util_timestamp).txt}"
    _info "Logging CPU stats every ${interval}s to $out  (Ctrl+C to stop)"
    while true; do
        echo "=== $(date --iso-8601=seconds) ===" >> "$out"
        top -bn1 | head -5 >> "$out"
        sleep "$interval"
    done
}


