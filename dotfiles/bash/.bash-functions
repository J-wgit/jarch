    sudo pacman-key --refresh-keys
    sudo pacman-key --populate archlinux
    _section "Refreshing database"
    sudo pacman -Syy
    _ok "Pacman repaired."
}

# maint_locate_update — update mlocate/plocate database
maint_locate_update() {
    _title "Updating locate database"
    if command -v updatedb &>/dev/null; then
        sudo updatedb && _ok "Database updated."
