    fc-cache -fv
    mkfontscale ~/.local/share/fonts 2>/dev/null
    mkfontdir   ~/.local/share/fonts 2>/dev/null
    _ok "Font cache rebuilt."
}

# maint_mime_update — update MIME database
maint_mime_update() {
