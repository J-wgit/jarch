}

# maint_check_filesystem — check filesystems for errors (unmounted/read-only mounts)
maint_check_filesystem() {
    _title "Filesystem Check"
    _warn "This should be run on unmounted filesystems. Use from recovery/initramfs for root."
    local device="${1:-}"
    if [[ -n "$device" ]]; then
        sudo fsck -n "$device"
    else
        _info "Pass a device (e.g. /dev/sda1) to check it."
        lsblk -o NAME,MOUNTPOINT,FSTYPE | grep -v MOUNTPOINT
    fi
}

# maint_trim — run fstrim for SSDs
maint_trim() {
    _title "SSD TRIM"
    sudo fstrim -av
}

# maint_fix_perms — fix common broken permissions in home directory
maint_fix_perms() {
    _title "Fixing Home Directory Permissions"
    _info "Setting ~/.ssh to 700 and keys to 600..."
    [[ -d ~/.ssh ]] && {
        chmod 700 ~/.ssh
        chmod 600 ~/.ssh/*
        chmod 644 ~/.ssh/*.pub 2>/dev/null
        _ok "~/.ssh permissions fixed."
    }
    _info "Setting ~/.gnupg to 700..."
    [[ -d ~/.gnupg ]] && {
        chmod 700 ~/.gnupg
        find ~/.gnupg -type f -exec chmod 600 {} \;
        _ok "~/.gnupg permissions fixed."
    }
    _info "Resetting home directory to 755..."
    chmod 755 ~
    _ok "Permissions fixed."
}

# maint_pacman_fix — fix common pacman issues (lock file, corrupt db)
maint_pacman_fix() {
    _title "Pacman Database Repair"
    _section "Removing lock file"
    [[ -f /var/lib/pacman/db.lck ]] && sudo rm /var/lib/pacman/db.lck && _ok "Lock removed."
