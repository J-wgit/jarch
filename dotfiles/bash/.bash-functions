# Source from ~/.bashrc or ~/.zshrc:
#   [ -f "$HOME/.bash-functions" ] && source "$HOME/.bash-functions"
#
# CATEGORIES
# ----------
#  1.  Core Utilities & Helpers         (util_*)
#  2.  Package Management               (pkg_*)
#  3.  System Information & Hardware    (sys_*)
#  4.  System Maintenance               (maint_*)
#  5.  Filesystem & Disk                (fs_*)
#  6.  Process & Resource Management    (proc_*)
#  7.  Networking & Connectivity        (net_*)
#  8.  User & Permission Management     (usr_*)
#  9.  Systemd & Services               (svc_*)
# 10.  Security & Cryptography          (sec_*)
# 11.  Logging & Monitoring             (log_*)
# 12.  Backup & Restore                 (bak_*)
# 13.  Development Environment          (dev_*)
# 14.  Git & Version Control            (git_*)
# 15.  Build Systems                    (build_*)
# 16.  Container & Virtualisation       (ctr_*)
# 17.  Python & Virtual Environments    (py_*)
# 18.  Rust / Cargo                     (rust_*)
