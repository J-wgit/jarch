[[ "${_BASH_FUNCTIONS_LOADED:-}" == "1" ]] && return
_BASH_FUNCTIONS_LOADED=1

# ─── Internal colour/print helpers (used by all functions below) ──────────────

_clr_reset='\033[0m'
_clr_bold='\033[1m'
_clr_red='\033[0;31m'
_clr_green='\033[0;32m'
_clr_yellow='\033[0;33m'
_clr_blue='\033[0;34m'
_clr_cyan='\033[0;36m'
_clr_magenta='\033[0;35m'
_clr_white='\033[0;37m'

_info()    { echo -e "${_clr_blue}[INFO]${_clr_reset}  $*"; }
_ok()      { echo -e "${_clr_green}[OK]${_clr_reset}    $*"; }
_warn()    { echo -e "${_clr_yellow}[WARN]${_clr_reset}  $*"; }
_err()     { echo -e "${_clr_red}[ERR]${_clr_reset}   $*" >&2; }
_title()   { echo -e "\n${_clr_bold}${_clr_cyan}══ $* ══${_clr_reset}\n"; }
_section() { echo -e "${_clr_magenta}── $* ──${_clr_reset}"; }
_die()     { _err "$*"; return 1; }

# Check for required commands before running a function
_require() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" &>/dev/null || _die "Required command not found: '$cmd'"
    done
}

# Confirm prompt — returns 0 on yes, 1 on no
_confirm() {
    local prompt="${1:-Are you sure?}"
    local reply
    read -r -p "$(echo -e "${_clr_yellow}${prompt} [y/N] ${_clr_reset}")" reply
    [[ "${reply,,}" =~ ^y(es)?$ ]]
}


# =============================================================================
# 1. CORE UTILITIES & HELPERS (util_*)
# =============================================================================

# util_help — list all functions in this file with their descriptions
util_help() {
    _title "bash-functions reference"
    grep -E '^# [a-z_]+\(\) —' "$BASH_SOURCE" 2>/dev/null ||
    grep -E '^[a-z_]+\(\)\s*\{' "$BASH_SOURCE" | sed 's/() {//' | column
}

# util_reload — reload this functions file
util_reload() {
    # shellcheck source=/dev/null
    source "${BASH_SOURCE[0]}" && _ok "Functions reloaded from ${BASH_SOURCE[0]}"
}

# util_which_all — show all locations of a command name (not just the first)
util_which_all() {
    [[ -z "$1" ]] && { _err "Usage: util_which_all <command>"; return 1; }
    type -a "$1"
    command -v "$1" && whereis "$1"
}

# util_path_add — prepend a directory to PATH (no duplicates)
util_path_add() {
    [[ -z "$1" ]] && { _err "Usage: util_path_add <dir>"; return 1; }
    [[ -d "$1" ]] || { _err "Directory does not exist: $1"; return 1; }
    case ":$PATH:" in
        *":$1:"*) _warn "$1 already in PATH" ;;
        *) export PATH="$1:$PATH" && _ok "Added $1 to PATH" ;;
    esac
}

# util_path_show — print PATH entries one per line, highlight missing dirs
util_path_show() {
    _title "PATH entries"
    local entry
    IFS=':' read -ra entries <<< "$PATH"
    for entry in "${entries[@]}"; do
        if [[ -d "$entry" ]]; then
            echo -e "  ${_clr_green}✔${_clr_reset}  $entry"
        else
            echo -e "  ${_clr_red}✘${_clr_reset}  $entry  (missing)"
        fi
    done
}

# util_mkcd — create directory (including parents) and cd into it
util_mkcd() {
    [[ -z "$1" ]] && { _err "Usage: util_mkcd <dir>"; return 1; }
    mkdir -p "$1" && cd "$1" && _ok "Created and entered: $1"
}

# util_extract — universal archive extractor
util_extract() {
    local file="$1"
    [[ -z "$file" ]] && { _err "Usage: util_extract <archive>"; return 1; }
    [[ -f "$file" ]] || { _err "File not found: $file"; return 1; }
    _info "Extracting: $file"
    case "$file" in
        *.tar.bz2|*.tbz2) tar xjvf "$file" ;;
        *.tar.gz|*.tgz)   tar xzvf "$file" ;;
        *.tar.xz|*.txz)   tar xJvf "$file" ;;
        *.tar.zst)         tar --zstd -xvf "$file" ;;
        *.tar)             tar xvf  "$file" ;;
        *.bz2)             bunzip2  "$file" ;;
        *.gz)              gunzip   "$file" ;;
        *.xz)              unxz     "$file" ;;
        *.zst)             unzstd   "$file" ;;
        *.zip)             unzip    "$file" ;;
        *.rar)             unrar x  "$file" ;;
        *.7z)              7z x     "$file" ;;
        *.Z)               uncompress "$file" ;;
        *)  _err "Unrecognised archive format: $file"; return 1 ;;
    esac && _ok "Done."
}

# util_compress — create archive from files/dirs
# Usage: util_compress <output.tar.gz> <file|dir> [...]
util_compress() {
    [[ $# -lt 2 ]] && { _err "Usage: util_compress <output.ext> <file|dir> [...]"; return 1; }
    local out="$1"; shift
    case "$out" in
        *.tar.gz|*.tgz)  tar czvf "$out" "$@" ;;
        *.tar.bz2|*.tbz) tar cjvf "$out" "$@" ;;
        *.tar.xz)         tar cJvf "$out" "$@" ;;
        *.tar.zst)        tar --zstd -cvf "$out" "$@" ;;
        *.zip)            zip -r   "$out" "$@" ;;
        *.7z)             7z a     "$out" "$@" ;;
        *) _err "Unknown extension for: $out"; return 1 ;;
    esac && _ok "Created: $out"
}

# util_timestamp — generate a filename-safe ISO timestamp
util_timestamp() {
    date "+%Y%m%d_%H%M%S"
}

# util_iso8601 — generate an ISO 8601 datetime string
util_iso8601() {
    date "+%Y-%m-%dT%H:%M:%S%z"
}

# util_repeat — run a command N times
# Usage: util_repeat <N> <command> [args...]
util_repeat() {
    local n="$1"; shift
    [[ "$n" =~ ^[0-9]+$ ]] || { _err "Usage: util_repeat <N> <command>"; return 1; }
    local i
    for ((i=1; i<=n; i++)); do
        _info "Run $i/$n: $*"
        "$@" || { _err "Command failed on run $i"; return 1; }
    done
}

# util_retry — retry a command up to N times with delay
# Usage: util_retry <attempts> <delay_secs> <command> [args...]
util_retry() {
    local attempts="$1" delay="$2"; shift 2
    local i
    for ((i=1; i<=attempts; i++)); do
        "$@" && return 0
        _warn "Attempt $i/$attempts failed. Retrying in ${delay}s..."
        sleep "$delay"
    done
    _err "All $attempts attempts failed: $*"
    return 1
}

# util_time_cmd — time a command with human-readable output
util_time_cmd() {
    local start end elapsed
    start=$(date +%s%N)
    "$@"
    local rc=$?
    end=$(date +%s%N)
    elapsed=$(( (end - start) / 1000000 ))
    _info "Elapsed: ${elapsed}ms  (exit code: $rc)"
    return $rc
}

# util_genpass — generate a cryptographically random password
# Usage: util_genpass [length=32]
util_genpass() {
    local len="${1:-32}"
    < /dev/urandom tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' | head -c "$len"
    echo
}

# util_genpass_words — generate a passphrase from /usr/share/dict/words
# Usage: util_genpass_words [word_count=4]
util_genpass_words() {
    local count="${1:-4}"
    local words_file="/usr/share/dict/words"
    [[ -f "$words_file" ]] || { _err "Word list not found: $words_file"; return 1; }
    shuf -n "$count" "$words_file" | tr '\n' '-' | sed 's/-$//'
    echo
}

# util_qr — display a QR code in the terminal
util_qr() {
    _require qrencode
    [[ -z "$1" ]] && { _err "Usage: util_qr <text|url>"; return 1; }
    qrencode -t UTF8 "$1"
}

# util_hex — hex dump a file with optional search
# Usage: util_hex <file> [search_string]
util_hex() {
    [[ -z "$1" ]] && { _err "Usage: util_hex <file> [search]"; return 1; }
    if [[ -n "$2" ]]; then
        xxd "$1" | grep --color=auto "$2"
    else
        xxd "$1" | less
    fi
}

# util_calc — interactive calculator (or evaluate expression)
# Usage: util_calc [expression]
util_calc() {
    if [[ -n "$1" ]]; then
        echo "$*" | bc -l
    else
        bc -l
    fi
}

# util_json_pp — pretty-print JSON from file or stdin
util_json_pp() {
    if [[ -n "$1" ]]; then
        python3 -m json.tool "$1"
    else
        python3 -m json.tool
    fi
}

# util_yaml_check — validate a YAML file
util_yaml_check() {
    _require python3
    [[ -z "$1" ]] && { _err "Usage: util_yaml_check <file.yaml>"; return 1; }
    python3 -c "import yaml, sys; yaml.safe_load(open('$1'))" \
        && _ok "YAML valid: $1" || _err "YAML invalid: $1"
}

# util_toml_check — validate a TOML file
util_toml_check() {
    _require python3
    [[ -z "$1" ]] && { _err "Usage: util_toml_check <file.toml>"; return 1; }
    python3 -c "import tomllib, sys; tomllib.load(open('$1','rb'))" \
        && _ok "TOML valid: $1" || _err "TOML invalid: $1"
}


# =============================================================================
# 2. PACKAGE MANAGEMENT (pkg_*)
# =============================================================================

# pkg_install — install one or more packages (tries yay, falls back to pacman)
pkg_install() {
    [[ $# -eq 0 ]] && { _err "Usage: pkg_install <pkg> [pkg...]"; return 1; }
    if command -v yay &>/dev/null; then
        yay -S --needed "$@"
    else
        sudo pacman -S --needed "$@"
    fi
}

# pkg_remove — remove package(s) with dependencies and config
pkg_remove() {
    [[ $# -eq 0 ]] && { _err "Usage: pkg_remove <pkg> [pkg...]"; return 1; }
    _confirm "Remove packages: $*?" || return 1
    sudo pacman -Rns "$@"
}

# pkg_upgrade — full system upgrade (AUR included if yay present)
pkg_upgrade() {
    _title "Full System Upgrade"
    if command -v yay &>/dev/null; then
        yay -Syu
    else
        sudo pacman -Syu
    fi
}

# pkg_upgrade_keys — refresh pacman keyring before upgrading
pkg_upgrade_keys() {
    _title "Refreshing Pacman Keys"
    sudo pacman-key --refresh-keys
    sudo pacman-key --populate archlinux
    pkg_upgrade
}

# pkg_search — search repos and AUR simultaneously
pkg_search() {
    [[ -z "$1" ]] && { _err "Usage: pkg_search <term>"; return 1; }
    if command -v yay &>/dev/null; then
        yay -Ss "$1"
    else
        pacman -Ss "$1"
    fi
}

# pkg_info — show detailed info for a package (installed or remote)
pkg_info() {
    [[ -z "$1" ]] && { _err "Usage: pkg_info <pkg>"; return 1; }
    if pacman -Qi "$1" &>/dev/null; then
        pacman -Qi "$1"
    else
        pacman -Si "$1" 2>/dev/null || \
        { command -v yay &>/dev/null && yay -Si "$1"; }
    fi
}

# pkg_files — list files owned by an installed package
pkg_files() {
    [[ -z "$1" ]] && { _err "Usage: pkg_files <pkg>"; return 1; }
    pacman -Ql "$1"
}

# pkg_owns — find which package owns a file
pkg_owns() {
    [[ -z "$1" ]] && { _err "Usage: pkg_owns <file>"; return 1; }
    pacman -Qo "$1"
}

# pkg_explicit — list all explicitly installed packages
pkg_explicit() {
    pacman -Qe | column
}

# pkg_explicit_native — explicitly installed packages from official repos only
pkg_explicit_native() {
    pacman -Qen
}

# pkg_explicit_aur — explicitly installed AUR/foreign packages
pkg_explicit_aur() {
    pacman -Qem
}

# pkg_orphans — list orphaned packages (no longer required as dependencies)
pkg_orphans() {
    local orphans
    orphans=$(pacman -Qtdq 2>/dev/null)
    if [[ -z "$orphans" ]]; then
        _ok "No orphaned packages found."
    else
        _warn "Orphaned packages:"
        echo "$orphans"
    fi
}

# pkg_clean_orphans — remove all orphaned packages
pkg_clean_orphans() {
    local orphans
    orphans=$(pacman -Qtdq 2>/dev/null)
    [[ -z "$orphans" ]] && { _ok "No orphans to remove."; return 0; }
    _warn "Orphans to remove:"
    echo "$orphans"
    _confirm "Remove these orphaned packages?" || return 1
    echo "$orphans" | xargs sudo pacman -Rns
}

# pkg_clean_cache — clean pacman cache (keep 2 most recent versions)
pkg_clean_cache() {
    _require paccache
    _info "Cleaning pacman cache (keeping 2 versions)..."
    sudo paccache -rk2
    sudo paccache -ruk0   # remove all cached uninstalled packages
    _ok "Cache cleaned."
}

# pkg_clean_all — orphans + cache + unused flatpaks
pkg_clean_all() {
    _title "Full System Cleanup"
    pkg_clean_orphans
    pkg_clean_cache
    if command -v flatpak &>/dev/null; then
        _info "Removing unused Flatpak runtimes..."
        flatpak uninstall --unused -y
    fi
    _ok "All cleanup done."
}

# pkg_list_sizes — list installed packages sorted by installed size
pkg_list_sizes() {
    local n="${1:-30}"
    _title "Top $n packages by installed size"
    expac -s "%-35n %m" | sort -hk2 | tail -"$n" | awk '{
        size=$2; unit="B"
        if(size>1073741824){size/=1073741824; unit="GiB"}
        else if(size>1048576){size/=1048576; unit="MiB"}
        else if(size>1024){size/=1024; unit="KiB"}
        printf "%-35s  %6.1f %s\n", $1, size, unit
    }' | sort -k2 -rh
}

# pkg_check_updates — list available updates without installing
pkg_check_updates() {
    _title "Available Updates"
    if command -v yay &>/dev/null; then
        yay -Qu
    else
        pacman -Qu
    fi
}

# pkg_install_group — install an entire pacman group
pkg_install_group() {
    [[ -z "$1" ]] && { _err "Usage: pkg_install_group <group>"; return 1; }
    pacman -Sg "$1" | awk '{print $2}' | xargs sudo pacman -S --needed
}

# pkg_mirrors_update — refresh mirrorlist using reflector for fastest mirrors
pkg_mirrors_update() {
    _require reflector
    _title "Updating Pacman Mirrorlist"
    _info "Fetching fastest mirrors (this may take a minute)..."
    sudo reflector \
        --country GB,DE,NL,FR \
        --protocol https \
        --latest 20 \
        --sort rate \
        --save /etc/pacman.d/mirrorlist
    _ok "Mirrorlist updated."
    _info "Syncing databases..."
    sudo pacman -Syy
}

# pkg_verify — verify integrity of installed package files
pkg_verify() {
    [[ -z "$1" ]] && { _err "Usage: pkg_verify <pkg>"; return 1; }
    _info "Verifying: $1"
    pacman -Qkk "$1"
}

# pkg_downgrade — downgrade a package using cached versions
pkg_downgrade() {
    [[ -z "$1" ]] && { _err "Usage: pkg_downgrade <pkg>"; return 1; }
    local cache_dir="/var/cache/pacman/pkg"
    local versions
    versions=$(ls "${cache_dir}/${1}"-[0-9]*.pkg.tar.* 2>/dev/null | sort -rV)
    if [[ -z "$versions" ]]; then
        _err "No cached versions found for: $1"
        _info "Tip: use 'downgrade' (AUR) for more options"
        return 1
    fi
    _info "Available cached versions:"
    echo "$versions" | nl
    read -rp "Enter number to install: " choice
    local pkg
    pkg=$(echo "$versions" | sed -n "${choice}p")
    [[ -z "$pkg" ]] && { _err "Invalid selection."; return 1; }
    sudo pacman -U "$pkg"
}

# pkg_news — show latest Arch Linux news
pkg_news() {
    _require curl
    _title "Latest Arch Linux News"
    curl -s "https://archlinux.org/feeds/news/" | \
        grep -oP '(?<=<title>)[^<]+' | tail -n +2 | head -10 | nl
}


# =============================================================================
# 3. SYSTEM INFORMATION & HARDWARE (sys_*)
# =============================================================================

# sys_info — comprehensive system overview
sys_info() {
    _title "System Overview"
    _section "OS & Kernel"
    echo "  Hostname : $(hostnamectl hostname)"
    echo "  OS       : $(grep PRETTY_NAME /etc/os-release | cut -d'"' -f2)"
    echo "  Kernel   : $(uname -r)"
    echo "  Arch     : $(uname -m)"

    _section "CPU"
    echo "  Model    : $(grep 'model name' /proc/cpuinfo | head -1 | cut -d':' -f2 | xargs)"
    echo "  Cores    : $(nproc) logical / $(grep 'cpu cores' /proc/cpuinfo | head -1 | awk '{print $4}') physical"
    echo "  Governor : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'N/A')"

    _section "Memory"
    free -h | awk '/Mem/{printf "  RAM      : %s used / %s total\n", $3, $2}'
    free -h | awk '/Swap/{printf "  Swap     : %s used / %s total\n", $3, $2}'

    _section "Disk"
    df -hT | awk 'NR==1 || /\/dev\// {printf "  %-15s %-8s %-6s %-6s %-6s %s\n",$1,$2,$3,$4,$5,$7}'

    _section "Network"
    ip -4 addr | awk '/inet / && !/127\.0\.0\.1/ {printf "  %-12s %s\n", $NF, $2}'

    _section "Uptime"
    uptime -p | sed 's/up /  /'
}

# sys_cpu — detailed CPU information
sys_cpu() {
    _title "CPU Information"
    lscpu
    echo ""
    _section "Current Frequencies"
    grep 'MHz' /proc/cpuinfo | awk -F': ' '{printf "  Core: %.0f MHz\n", $2}' | sort -u
}

# sys_cpu_governor — show or set CPU frequency governor
# Usage: sys_cpu_governor [governor]
sys_cpu_governor() {
    local available
    available=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null)
    if [[ -z "$1" ]]; then
        _info "Current governor : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
        _info "Available        : $available"
        return 0
    fi
    _info "Setting governor to: $1"
    echo "$1" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
}

# sys_mem — memory statistics
sys_mem() {
    _title "Memory Statistics"
    free -h
    echo ""
    _section "Top Memory Consumers"
    ps aux --sort=-%mem | awk 'NR==1 || NR<=11{printf "  %-25s %5s%% %s MB\n", $11, $4, $6/1024}' | head -12
}

# sys_mem_clear — clear reclaimable caches (safe, kernel reclaims as needed)
sys_mem_clear() {
    _confirm "Sync and clear PageCache/dentries/inodes?" || return 1
    sync
    echo 3 | sudo tee /proc/sys/vm/drop_caches
    _ok "Memory caches cleared."
    free -h
}

# sys_temps — CPU and GPU temperatures
sys_temps() {
    _title "System Temperatures"
    if command -v sensors &>/dev/null; then
        sensors
    else
        _warn "lm_sensors not installed. Trying thermal zones..."
        for zone in /sys/class/thermal/thermal_zone*; do
            local temp type
            temp=$(cat "$zone/temp" 2>/dev/null)
            type=$(cat "$zone/type" 2>/dev/null)
            printf "  %-20s %s°C\n" "$type" "$((temp/1000))"
        done
    fi
    if command -v nvidia-smi &>/dev/null; then
        _section "GPU (NVIDIA)"
        nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total \
                   --format=csv,noheader
    fi
}

# sys_gpu — GPU information
sys_gpu() {
    _title "GPU Information"
    if command -v nvidia-smi &>/dev/null; then
        nvidia-smi
    elif command -v radeontop &>/dev/null; then
        radeontop -d - -l 1
    else
        lspci | grep -i 'vga\|display\|3d\|gpu'
    fi
}

# sys_hw — all hardware (PCI, USB, block devices)
sys_hw() {
    _title "Hardware Summary"
    _section "PCI Devices"
    lspci -k | grep -A2 "VGA\|Audio\|Network\|USB\|NVMe\|SATA"
    _section "USB Devices"
    lsusb
    _section "Block Devices"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT,MODEL
}

# sys_boot_time — show systemd boot time analysis
sys_boot_time() {
    _title "Boot Time Analysis"
    systemd-analyze
    echo ""
    _section "Critical Chain"
    systemd-analyze critical-chain
    echo ""
    _section "Top 20 Slowest Units"
    systemd-analyze blame | head -20
}

# sys_kernel_mods — list loaded kernel modules, optional filter
# Usage: sys_kernel_mods [filter]
sys_kernel_mods() {
    if [[ -n "$1" ]]; then
        lsmod | grep -i "$1"
    else
        lsmod | sort | less
    fi
}

# sys_dmi — show DMI/BIOS/motherboard information
sys_dmi() {
    _title "DMI / Hardware Identity"
    sudo dmidecode -t system
    sudo dmidecode -t baseboard
    sudo dmidecode -t bios
}

# sys_env — display environment variables, optionally filtered
# Usage: sys_env [filter]
sys_env() {
    if [[ -n "$1" ]]; then
        env | grep -i "$1" | sort
    else
        env | sort | less
    fi
}


# =============================================================================
# 4. SYSTEM MAINTENANCE (maint_*)
# =============================================================================

# maint_full — run all standard maintenance tasks
maint_full() {
    _title "Full System Maintenance"
    maint_update
    maint_clean
    maint_journal_vac
    maint_failed_units
    maint_check_errors
    _ok "Full maintenance complete."
}

# maint_update — upgrade system + AUR + Flatpaks
maint_update() {
    _title "System Update"
    _section "Pacman / AUR"
    if command -v yay &>/dev/null; then
        yay -Syu --noconfirm
    else
        sudo pacman -Syu
    fi
    if command -v flatpak &>/dev/null; then
        _section "Flatpak"
        flatpak update -y
    fi
    _ok "System updated."
}

# maint_clean — clean caches, orphans, temp files
maint_clean() {
    _title "System Cleanup"

    _section "Removing orphaned packages"
    local orphans
    orphans=$(pacman -Qtdq 2>/dev/null)
    if [[ -n "$orphans" ]]; then
        echo "$orphans"
        if _confirm "Remove orphans?"; then
            echo "$orphans" | xargs sudo pacman -Rns
        fi
    else
        _ok "No orphans."
    fi

    _section "Cleaning pacman cache"
    if command -v paccache &>/dev/null; then
        sudo paccache -rk2
        sudo paccache -ruk0
    else
        sudo pacman -Sc --noconfirm
    fi

    _section "Cleaning user caches"
    local cache_size
    cache_size=$(du -sh ~/.cache 2>/dev/null | cut -f1)
    _info "~/.cache size: $cache_size"
    if _confirm "Clear ~/.cache?"; then
        rm -rf ~/.cache/*
        _ok "User cache cleared."
    fi

    _section "Removing broken symlinks in ~"
    find ~ -maxdepth 4 -xtype l -not -path '*/.git/*' 2>/dev/null | while read -r link; do
        _warn "Broken symlink: $link"
        _confirm "Remove $link?" && rm "$link"
    done

    _section "Cleaning pip cache"
    if command -v pip &>/dev/null; then
        pip cache purge 2>/dev/null && _ok "pip cache purged."
    fi

    _section "Cleaning cargo cache"
    if command -v cargo &>/dev/null && command -v cargo-cache &>/dev/null; then
        cargo cache --autoclean
    fi

    _section "Cleaning npm cache"
    if command -v npm &>/dev/null; then
        npm cache clean --force 2>/dev/null && _ok "npm cache cleaned."
    fi

    _ok "Cleanup complete."
}

# maint_journal_vac — vacuum systemd journal logs
# Usage: maint_journal_vac [days=14]
maint_journal_vac() {
    local days="${1:-14}"
    _title "Journal Vacuum (keep ${days} days)"
    sudo journalctl --vacuum-time="${days}d"
    sudo journalctl --vacuum-size=512M
    _ok "Journal vacuumed."
}

# maint_failed_units — show failed systemd units
maint_failed_units() {
    _title "Failed Systemd Units"
    _section "System"
    systemctl --failed
    _section "User"
    systemctl --user --failed
}

# maint_check_errors — scan journals for recent errors
maint_check_errors() {
    _title "Recent System Errors (last 24h)"
    journalctl -p err -xb --since="24 hours ago" --no-pager | tail -50
}

# maint_check_disk_health — run SMART tests on all disks
maint_check_disk_health() {
    _require smartctl
    _title "Disk SMART Health"
    local disks
    disks=$(lsblk -dno NAME | grep -E '^(sd|nvme|vd)')
    for disk in $disks; do
        _section "/dev/$disk"
