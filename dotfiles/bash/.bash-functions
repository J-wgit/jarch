# build_cmake_debug — configure and build a CMake project (Debug)
build_cmake_debug() {
    local build_dir="${1:-build/debug}"
    mkdir -p "$build_dir"
    cmake -B "$build_dir" -DCMAKE_BUILD_TYPE=Debug \
          -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
          -G Ninja
    cmake --build "$build_dir" -j "$(nproc)"
}

# build_cmake_release — configure and build a CMake project (Release)
build_cmake_release() {
    local build_dir="${1:-build/release}"
    mkdir -p "$build_dir"
    cmake -B "$build_dir" -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
          -G Ninja
    cmake --build "$build_dir" -j "$(nproc)"
}

# build_cmake_clean — remove all cmake build artifacts
build_cmake_clean() {
    _confirm "Remove build/ directory?" || return 1
    rm -rf build/ CMakeCache.txt CMakeFiles/ cmake_install.cmake Makefile
    _ok "CMake artifacts removed."
}

# build_make_parallel — run make with all available cores
build_make_parallel() {
    make -j"$(nproc)" "$@"
}

# build_compile_db — generate compile_commands.json for LSP (clangd)
# Works with cmake or bear+make
build_compile_db() {
    if [[ -f CMakeLists.txt ]]; then
        _info "CMake project detected."
        build_cmake_debug
        ln -sf build/debug/compile_commands.json . 2>/dev/null
        _ok "Linked compile_commands.json from cmake build."
    elif [[ -f Makefile ]] && command -v bear &>/dev/null; then
        _info "Makefile project — using bear"
        bear -- make -j"$(nproc)"
        _ok "compile_commands.json generated."
    else
        _err "Cannot generate compile_commands.json: no CMakeLists.txt or Makefile+bear."
    fi
}

# build_asan — build with AddressSanitizer (GCC/Clang)
build_asan() {
    local build_dir="build/asan"
    mkdir -p "$build_dir"
    cmake -B "$build_dir" \
          -DCMAKE_BUILD_TYPE=Debug \
          -DCMAKE_C_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer" \
          -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=address,undefined" \
          -G Ninja
    cmake --build "$build_dir" -j "$(nproc)"
    _ok "ASan build ready in $build_dir/"
}

# build_strip_binary — strip debug symbols from a binary
build_strip_binary() {
    [[ -z "$1" ]] && { _err "Usage: build_strip_binary <binary>"; return 1; }
    local orig_size
    orig_size=$(stat -c%s "$1")
    strip "$1"
    local new_size
    new_size=$(stat -c%s "$1")
    _ok "Stripped $1: $orig_size → $new_size bytes"
}


