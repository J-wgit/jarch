# rust_new — create a new Rust project with recommended structure
# Usage: rust_new <name> [--lib]
rust_new() {
    [[ -z "$1" ]] && { _err "Usage: rust_new <name> [--lib]"; return 1; }
    local name="$1" flag="${2:-}"
    if [[ "$flag" == "--lib" ]]; then
        cargo new --lib "$name"
    else
        cargo new "$name"
    fi
    cd "$name" || return 1

    # Add useful dev dependencies
    cat >> Cargo.toml <<'EOF'

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
strip = true

[profile.dev]
opt-level = 0
debug = true
EOF

    _ok "Rust project created: $name"
}

