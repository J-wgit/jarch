# dev_ctags — regenerate ctags for a project
dev_ctags() {
    _require ctags
    ctags -R --exclude='.git' --exclude='node_modules' --exclude='target' \
          --exclude='.venv' --exclude='build' .
    _ok "ctags generated"
}

# dev_count_lines — count lines of code by language
dev_count_lines() {
    local path="${1:-.}"
    if command -v tokei &>/dev/null; then
        tokei "$path"
    elif command -v cloc &>/dev/null; then
        cloc "$path"
    else
        _info "Fallback: raw line count per extension"
        find "$path" -type f -not -path '*/.git/*' -not -path '*/node_modules/*' \
            -not -path '*/.venv/*' -not -path '*/target/*' | \
            awk -F. '{print $NF}' | sort | uniq -c | sort -rn
    fi
}

# dev_deps_check — check for outdated dependencies in various ecosystems
dev_deps_check() {
    _title "Outdated Dependencies"
    if [[ -f Cargo.toml ]] && command -v cargo-outdated &>/dev/null; then
        _section "Rust (cargo)"
        cargo outdated
    fi
    if [[ -f package.json ]] && command -v npm &>/dev/null; then
        _section "Node.js (npm)"
        npm outdated 2>/dev/null
    fi
    if [[ -f requirements.txt ]] && command -v pip &>/dev/null; then
        _section "Python (pip)"
        pip list --outdated 2>/dev/null
    fi
    if [[ -f go.mod ]] && command -v go &>/dev/null; then
        _section "Go"
        go list -m -u all 2>/dev/null
    fi
}


