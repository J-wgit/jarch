# ai_rag_prepare — prepare a directory for RAG (chunk and tokenize text files)
# Saves chunked text to .rag_chunks/ for embedding
# Usage: ai_rag_prepare [source_dir=.] [chunk_size=500]
ai_rag_prepare() {
    _require python3
    local src="${1:-.}" chunk="${2:-500}"
    local out=".rag_chunks"
    mkdir -p "$out"
    _info "Preparing RAG chunks from $src (chunk_size=$chunk words)..."
    python3 <<PYEOF
import os, re, pathlib

source_dir = "$src"
chunk_size = $chunk
out_dir = "$out"
chunk_num = 0

exts = {'.py','.rs','.ts','.js','.go','.c','.cpp','.h','.md','.txt','.lua','.sh'}

for path in pathlib.Path(source_dir).rglob('*'):
    if path.suffix.lower() not in exts: continue
    if any(p in str(path) for p in ['.git','node_modules','.venv','target']): continue
    try:
        text = path.read_text(errors='replace')
    except Exception:
        continue
    words = text.split()
    for i in range(0, len(words), chunk_size):
        chunk_text = ' '.join(words[i:i+chunk_size])
        chunk_file = os.path.join(out_dir, f'chunk_{chunk_num:06d}.txt')
        meta_file  = os.path.join(out_dir, f'chunk_{chunk_num:06d}.meta')
        pathlib.Path(chunk_file).write_text(chunk_text)
        pathlib.Path(meta_file).write_text(f'source: {path}\nword_start: {i}\n')
        chunk_num += 1

print(f'  Created {chunk_num} chunks in {out_dir}/')
PYEOF
    _ok "RAG preparation done. Chunks in $out/"
}


