# Jarch's own tool: files come from this repo's tree, not a download.
# The version bumps itself: r<N> counts the commits that touched the paths in
# _paths, so every merged change to the tool publishes a new build.
pkgname=jarch-manager
_basever=1.0.0
_jarch="$(realpath "$startdir/../..")"
_paths=(tools/jarch-manager pkgbuilds/jarch-manager)
pkgver=$_basever.r$(git -C "$_jarch" rev-list --count HEAD -- "${_paths[@]}" 2>/dev/null || echo 0)
pkgrel=1
pkgdesc="Jarch system manager: updates, cleanup, services, monitoring, backups, kernels"
arch=(any)
url="https://github.com/J-wgit/jarch"
license=(unknown)
depends=(bash pacman systemd coreutils sudo)
optdepends=(
    'pacman-contrib: paccache cache cleanup and checkupdates'
    'paru: AUR updates'
    'yay: AUR updates'
)

package() {
    local src="$_jarch/tools/jarch-manager"
    install -Dm755 "$src/arch-manager.sh" "$pkgdir/usr/bin/jarch-manager"
    install -Dm644 -t "$pkgdir/usr/share/doc/jarch-manager" \
        "$src"/{README,INSTALL,QUICK_REFERENCE,AUTOMATION_EXAMPLES}.md
}
