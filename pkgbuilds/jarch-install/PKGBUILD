# Jarch's own tool: files come from this repo's tree, not a download.
# The version bumps itself: r<N> counts the commits that touched the paths in
# _paths, so every merged change to the tool publishes a new build.
pkgname=jarch-install
_basever=0.1.0
_jarch="$(realpath "$startdir/../..")"
_paths=(tools/jarch-install pkgbuilds/jarch-install)
pkgver=$_basever.r$(git -C "$_jarch" rev-list --count HEAD -- "${_paths[@]}" 2>/dev/null || echo 0)
pkgrel=1
pkgdesc="Jarch: runs the Jarch installer from your checkout, cloning it first if needed"
arch=(any)
url="https://github.com/J-wgit/jarch"
license=(unknown)
depends=(bash git sudo stow)

package() {
    install -Dm755 "$_jarch/tools/jarch-install/jarch-install" "$pkgdir/usr/bin/jarch-install"
}
