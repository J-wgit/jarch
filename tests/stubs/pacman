#!/usr/bin/env bash
# Stub pacman for offline tests: records calls, tracks "installed" packages in $STUB_DB.
echo "pacman $*" >>"${STUB_LOG:?}"
case "$1" in
    -Qq|-Qi|-Q) grep -qx "$2" "$STUB_DB" 2>/dev/null ;;
    -S*) for a in "$@"; do [[ "$a" == -* ]] || echo "$a" >>"$STUB_DB"; done ;;
    -R*) for a in "$@"; do [[ "$a" == -* ]] || sed -i "/^${a}\$/d" "$STUB_DB"; done ;;
    *) exit 0 ;;
esac
