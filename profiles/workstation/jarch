# AUR packages served prebuilt from the [jarch] repo (pkgbuilds/<name>).
# If [jarch] is unreachable they are built on this machine from pkgbuilds/.
etcher-bin            # balenaEtcher from upstream's release (the AUR's balena-etcher
                      # needs electron37, a from-source Chromium build)
bombadillo            # Gopher/Gemini terminal client
dms-shell             # DankMaterialShell for niri: bar, launcher, notifications, lock
                      # (builds dms-shell and dms-shell-niri)
tlrc                  # tldr client
